---
import Site from '../layouts/Site.astro';
import PageSection from '../components/PageSection.astro';
import PhotoBlock from '../components/PhotoBlock.astro';
import Spacer from '../components/Spacer.astro';
import TextBlock from '../components/TextBlock.astro';

const description = "Náš šachový klub se skládá ze 3 pobočných spolků - Lysá nad Labem, Brandýs nad Labem a Milovice. V rámci projektu \"Šachy do škol\" se v těchto městech věnujeme tréninku dětí ve vybraných mateřských a základních školách. Skupinové tréninky pak probíhají v Lysé nad Labem. Naše sídlo najdete v Brandýse nad Labem - Stará Boleslav.";
---

<Site title="O nás" description={description} image="galerie-liga-spuntu-7-kolo-vystaviste-700.png">
  <PageSection frame noColumns>
    <Spacer height={0} />
    <TextBlock><h1 class="wnd-align-center">O nás</h1></TextBlock>
    <Spacer height={1.83} />
    <TextBlock><p class="wnd-align-center">Náš šachový klub se skládá ze 3 pobočných spolků - Lysá nad Labem, Brandýs nad Labem a Milovice. V rámci projektu <strong>"Šachy do škol" </strong>se v těchto městech věnujeme tréninku dětí ve vybraných <strong>mateřských </strong>a <strong>základních </strong>školách. Skupinové tréninky pak probíhají v <strong>Lysé nad Labem</strong>. Naše sídlo najdete v <strong>Brandýse nad Labem - Stará Boleslav.</strong></p></TextBlock>
    <Spacer height={2} />
    <PhotoBlock image="galerie-liga-spuntu-7-kolo-vystaviste" alt="Liga Špuntů 7. kolo - Výstaviště" caption="Liga Špuntů 7. kolo - Výstaviště" aspect={72.74} margin={18.31} sizes="100vw" openOriginal />
    <Spacer height={2.75} />
    <TextBlock><p class="wnd-align-center"><span style="text-align:center">Jsme šachový klub sídlící v krásném Středočeském kraji, konkrétně v oblasti Polabí. Naše hlavní specializace jsou samozřejmě šachy, které jsou nejen sportem, ale také velkou vášní pro nás. Naši členové jsou různorodí - od začátečníků až po zkušené hráče, ale všichni mají společné jedno - <strong>lásku </strong><strong>ke hře</strong>. V našem klubu si můžete zahrát šachy nejen pro zábavu, ale také se můžete zapojit do soutěží a turnajů, které pořádáme.</span></p></TextBlock>
  </PageSection>
</Site>
