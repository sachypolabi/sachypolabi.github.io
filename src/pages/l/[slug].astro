---
import { getCollection, render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import ArticleDate from '../../components/ArticleDate.astro';
import PageSection from '../../components/PageSection.astro';
import TextBlock from '../../components/TextBlock.astro';
import Gallery from '../../components/Gallery.astro';
import galleries from '../../data/galleries.json';

export async function getStaticPaths() {
  const articles = await getCollection('aktuality');
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, summary, shareImage, gallery } = entry.data;
const photos = gallery ? galleries[gallery as keyof typeof galleries] : [];
const description = summary.replace(/<[^>]+>/g, '');
const shareUrl = encodeURIComponent(new URL(Astro.url.pathname, Astro.site).href);
---
<Site title={title} description={description} image={shareImage} article gallery={photos.length > 0}>
  <section class="s s-hm s-hm-bdh s-bdh cf sc-w wnd-w-wide wnd-s-normal wnd-h-auto wnd-nh-m wnd-p-cc" data-space="true">
    <div class="s-w cf">
      <div class="s-o cf">
        <div class="s-bg cf" aria-hidden="true"><div class="s-bg-l"></div></div>
        <div class="h-c s-c cf">
          <div class="s-bdh-c b b-s-l b-s-r b-cs cf">
            <div class="s-bdh-w">
              <h1 class="s-bdh-t"><span class="ld"><span class="ld-c">{title}</span></span></h1>
              <span class="s-bdh-d"><span class="ld"><span class="ld-c"><ArticleDate date={date} /></span></span></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <PageSection wider noColumns>
    <TextBlock>
      <p set:html={summary} />
      <Content />
    </TextBlock>
    {photos.length > 0 && <Gallery photos={photos} variant="slideshow" />}
  </PageSection>
  <PageSection noColumns>
    <TextBlock />
    <div slot="afterContent" class="s-bdf b-s b-s-t200 b-cs">
    <div class="s-bdf-share b-s-b200">
      <a class="share-facebook" href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Sdílet na Facebooku">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" /></svg>Share
      </a>
      <a class="share-x" href={`https://twitter.com/intent/tweet?url=${shareUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Sdílet na X">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2h3.7l-8.1 9.3L24 22h-7.5l-5.9-6.8L4.6 22H.8l8.1-9.3L0 2h7.7l5.3 6.1L18.9 2Zm-1.3 18h2L6.6 3.9H4.4L17.6 20Z" /></svg>Post
      </a>
    </div>
    </div>
  </PageSection>
</Site>

<style>
  .share-facebook, .share-x {
    display: inline-flex; align-items: center; gap: 6px; vertical-align: top;
    font: bold 14px/20px Helvetica, Arial, sans-serif; color: #fff; text-decoration: none;
  }
  .share-facebook { margin-right: 20px; padding: 4px 10px; border-radius: 4px; background: #1877f2; }
  .share-x { padding: 4px 12px; border-radius: 24px; background: #000; }
</style>

<style>
  .s-bdh { margin-top: -74px; }
  :global(.wt-blogpost .wnd-w-wider .s-c) { padding-top: calc(.4 * var(--section-y)); }
  :global(.wt-blogpost .wnd-w-wider .b-text-c) { max-width: 1024px; }
  @media (max-width: 599.98px) {
    :global(.wt-blogpost .sw-c > .s-basic:last-child .ez) { display: none; }
  }
  .s-bdh .s-o { padding-top: 74px; }
  .s-bdh .h-c {
    display: flex; align-items: center; justify-content: center; text-align: center;
    max-width: 1420px; margin-inline: auto; padding: 20px 0 8px;
  }
  .s-bdh-c { width: 100%; max-width: 1064px; padding-inline: 10px; }
  .s-bdh-t, .s-bdh-d { display: block; margin: 0 -10px; padding: 0; font-weight: 400; }
  .s-bdh-t { color: #4caf50; font-size: 36px; line-height: 1.3; }
  .s-bdh-d { color: #c3c3c3; font-size: 16px; line-height: 1.6; font-style: italic; }
  .s-bdh-t .ld, .s-bdh-d .ld { display: inline-block; }
  .s-bdh-t .ld { padding: 10px; }
  .s-bdh-d .ld { padding: 6px 10px; }
  .s-bdf { width: 100%; max-width: 1064px; padding: 20px 10px 10px; }
  .s-bdf-share { padding-bottom: 20px; font-size: 0; line-height: 0; }
  .share-x { justify-content: center; width: 73px; height: 28px; }
  @media (min-width: 600px) {
    .s-bdh .h-c { padding: 40px 10px 16px; }
    .s-bdh-c { padding-inline: 15px; }
    .s-bdh-t { font-size: 48px; }
    .s-bdf { padding: 30px 15px 15px; }
    .s-bdf-share { padding-bottom: 30px; }
  }
  @media (min-width: 768px) {
    .s-bdh-t { font-size: 52px; }
    .s-bdh-d { font-size: 17.2px; }
  }
  @media (min-width: 900px) {
    .s-bdh { margin-top: 0; }
    .s-bdh .s-o { padding-top: 0; }
    .s-bdh .h-c { padding: 50px 15px 20px; }
    .s-bdh-c { padding-inline: 20px; }
    .s-bdf { padding: 40px 20px 20px; }
    .s-bdf-share { padding-bottom: 40px; }
  }
  @media (min-width: 1200px) { .s-bdh .h-c { padding: 60px 20px 24px; } }
</style>
