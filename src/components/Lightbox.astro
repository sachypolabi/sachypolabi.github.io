<dialog class="lightbox" aria-label="Zvětšená fotografie">
  <div class="lightbox-toolbar">
    <div class="lightbox-step">
      <button type="button" data-previous aria-label="Předchozí fotografie">←</button>
      <span class="lightbox-number"></span>
      <button type="button" data-next aria-label="Další fotografie">→</button>
    </div>
    <button type="button" data-close autofocus>Zavřít</button>
  </div>
  <figure><figcaption aria-live="polite"></figcaption></figure>
</dialog>
